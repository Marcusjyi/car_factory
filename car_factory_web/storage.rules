rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(/databases/default/documents/admins/$(request.auth.uid))
        && firestore.get(/databases/default/documents/admins/$(request.auth.uid)).data.isApproved == true
        && firestore.get(/databases/default/documents/admins/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    function validImage() {
      return request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    match /product-images/{uid}/{productId}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /profile-images/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && validImage();
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    match /partner-images/{partnerId}/{fileName} {
      allow read: if true;
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    match /chat-images/{roomId}/{fileName} {
      allow read, write: if false;
    }

    match /support-files/{uid}/{inquiryId}/{fileName} {
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024;
      allow read: if signedIn() && request.auth.uid == uid;
    }
  }
}
